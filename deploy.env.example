# Copy to .env on the server. Visitors bring their own Gemini key, so nothing is required here.
# Optional: let people without a key try the demo using YOUR key + a secret code you share.
ACCESS_CODE=
GEMINI_API_KEY=
# Optional: allow another site (e.g. your GitHub Pages app) to call the API. Comma-separated origins.
CORS_ORIGINS=
MAX_CONCURRENT=1
